{
  "name": "siyuan-home",
  "version": "0.3.9",
  "type": "module",
  "description": "Lv Home - family & life butler plugin for Siyuan (https://b3log.org/siyuan)",
  "repository": "github:ai68298100/siyuan-home",
  "homepage": "https://github.com/ai68298100/siyuan-home/releases/latest",
  "author": "ai68298100",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "run-p dev:app dev:kernel",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:audit": "pnpm audit --prod --audit-level moderate",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:loader": "node scripts/verify-loader-semantics.mjs",
    "e2e:device": "node scripts/device-batch-e2e.mjs",
    "e2e:recovery": "node scripts/e2e-recovery.mjs",
    "e2e:value01": "node scripts/e2e-value01.mjs",
    "e2e:import": "node scripts/e2e-import.mjs",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:kernel": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=kernel vite build --watch",
    "check": "run-s check:types check:svelte check:i18n check:meta check:audit",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "node ./scripts/clean.js",
    "build": "run-s clean build:app build:kernel",
    "build:app": "cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "build:kernel": "cross-env NODE_ENV=production VITE_BUILD_TARGET=kernel vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "test": "vitest run",
    "test:live": "node scripts/test-live.mjs",
    "test:watch": "vitest",
    "ui:tabs": "node scripts/ui-walkthrough/shoot-tabs.mjs",
    "ui:mobile": "node scripts/ui-walkthrough/shoot-mobile.mjs",
    "ui:hover": "node scripts/ui-walkthrough/shoot-hover.mjs",
    "ui:media": "node scripts/ui-walkthrough/shoot-media.mjs",
    "ui:stress": "node scripts/ui-walkthrough/bulk-stress.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/livereload": "^0.9.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.2",
    "livereload": "^0.9.3",
    "lunar-typescript": "^1.8.6",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "pinyin-pro": "^3.29.4",
    "playwright": "1.63.0",
    "sass": "^1.105.1",
    "siyuan": "1.2.8",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
